# Copy to .env for local work, or set these in the Render service environment.
# .env is gitignored. Never commit real values — CI rejects them (.github/workflows/security.yml).

# ── Data sources (REQUIRED) ─────────────────────────────────────────
# The Google Sheet IDs. Without these the server starts but every lookup,
# quote and report comes back empty; /health reports sheets_configured:false.
DISPATCH_SHEET_ID=
SERVICE_SHEET_ID=
# Tab GIDs — defaults match the current sheets, override only if the tabs move.
DISPATCH_SHEET_GID=602263013
SERVICE_SHEET_GID=1320217925

# ── Staff gate (STRONGLY RECOMMENDED) ───────────────────────────────
# When set, the PII/ops endpoints and /mcp require this via the
# x-utrucking-key header: /dispatch_plan /billing_audit /sample_ids
# /debug_sheets /voice_qa_api /lookup_student /get_order_details
# UNSET MEANS OPEN TO THE ENTIRE INTERNET. Generate with:
#   python -c "import secrets; print(secrets.token_hex(24))"
# Send it as a HEADER, never as a ?key= query parameter — query strings
# are written to proxy logs, browser history and error trackers.
API_SECRET=

# ── Voice ───────────────────────────────────────────────────────────
# Retell REST key — powers the /voiceqa call history pull.
RETELL_API_KEY=
# The LLM behind the phone agent, used by tools/retell_suite.py.
RETELL_LLM_ID=

# ── AI features (optional; each degrades gracefully when absent) ─────
# Free at aistudio.google.com. Drives photo→quote, condition docs,
# unknown-item mapping, Spanish translation, and the call QA judge.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VISION_PROVIDER=gemini
# Alternatives to GEMINI_API_KEY for vision only:
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ── Deployment ──────────────────────────────────────────────────────
# Public base URL. Must match the host, or the MCP endpoint rejects
# remote clients with 421 Invalid Host.
RENDER_URL=https://utrucking-mcp.onrender.com
